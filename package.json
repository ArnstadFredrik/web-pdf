{
  "name": "web-hefte",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "xyz.kirken.pdfhefte",
    "productName": "PDF Hefte",
    "directories": {
      "output": "release"
    },
    "files": ["build/**", "electron/**"],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities",
      "icon": "static/icon.png"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "static/icon.png"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "generate:manifest": "node ./generate-manifest.js",
    "app:run": "node build",
    "electron:dev": "ADAPTER=static vite build && electron .",
    "electron:build": "ADAPTER=static vite build && electron-builder --mac",
    "electron:build:win": "ADAPTER=static vite build && electron-builder --win",
    "app:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tailwindcss/vite": "^4.1.18",
    "dropzone": "^6.0.0-beta.2",
    "pdf-lib": "^1.17.1",
    "print-js": "^1.6.0",
    "tailwindcss": "^4.1.18",
    "uniqid": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/wasm-node": "^4.53.3",
    "@sveltejs/adapter-netlify": "^5.2.4",
    "@sveltejs/adapter-node": "^5.5.1",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild-wasm": "^0.27.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "svelte": "^5.45.3",
    "vite": "^7.2.4"
  }
}
